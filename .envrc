if [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
use nix
# Machine-specific settings, such as a build directory on another disk, go in
# .envrc.local, which is not committed.
source_env_if_exists .envrc.local
# nixpkgs' apple-sdk exports DEVELOPER_DIR/SDKROOT, which hijacks /usr/bin/cc's
# xcselect resolution. Host builds must use the real Xcode toolchain.
unset DEVELOPER_DIR SDKROOT
